{
  "name": "apex-rush-2027",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scroll-story landing page for the fictional Apex Rush 2027 racing event",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "optimise:models": "node scripts/optimise-models.mjs",
    "capture": "node scripts/capture-stills.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "three": "0.186.1"
  }
}
